---
import "../styles/global.css";
import { SEO } from "astro-seo";
import { Font } from "astro:assets";
import Header from "@components/blocks/Header.astro";
import Footer from "@components/blocks/Footer.astro";
import ChatWithUs from "@components/blocks/ChatWithUs.astro";
import Auth0Guard from "@components/auth/Auth0Guard.astro";
import Auth0Guard from "../components/auth/Auth0Guard.astro";
export interface Props {
  title: string;
  description?: string;
}

export interface Props {
  title: string;
  description?: string;
  requiresAuth?: boolean;
}

const { title, description, requiresAuth = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-manrope" preload />
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title: title,
          type: "A type.",
          image: "",
        },
      }}
    />
  </head>
  <body data-requires-auth={requiresAuth ? "true" : undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="main">
      <slot />
    </main>
    <ChatWithUs />
    <Footer />
    <Auth0Guard />
  </body>
</html>
