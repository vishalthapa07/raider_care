---
import "../styles/global.css";
import { SEO } from "astro-seo";
import { Font } from "astro:assets";
import Header from "@components/blocks/Header.astro";
import Footer from "@components/blocks/Footer.astro";

export interface Props {
	title: string;
	description: string;
	slug: string;
}

const { title, description, slug } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<Font cssVariable="--font-jakarta" preload />
		<Font cssVariable="--font-manrope" preload />
		<SEO
			title={title}
			description={description}
			openGraph={{
				basic: {
					title: title,
					type: "A type.",
					image: "",
				},
			}}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<Header />
		<main id="main-content" class="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
