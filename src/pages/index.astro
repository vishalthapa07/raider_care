---
import "../styles/global.css";
import Layout from "@layouts/Layout.astro";
import HeroSection from "@components/blocks/HeroSection.astro";
import ServicesSection from "@components/blocks/ServicesSection.astro";
import WhySection from "@components/blocks/WhySection.astro";
import StatisticsSection from "@components/blocks/StatisticsSection.astro";
import TestimonialsSection from "@components/blocks/TestimonialsSection.astro";
import CtaSection from "@components/blocks/CtaSection.astro";
import data from "../content/HomePage.json";
---

<Layout
  title={data.pageTitle}
  description=`${data.pageTitle} description place here`
>
  {data.sections.hero && <HeroSection data={data.sections.hero} />}
  {data.sections.services && <ServicesSection data={data.sections.services} />}
  {data.sections.why && <WhySection data={data.sections.why} />}
  {
    data.sections.statistics && (
      <StatisticsSection data={data.sections.statistics} />
    )
  }
  {
    data.sections.testimonials && (
      <TestimonialsSection data={data.sections.testimonials} />
    )
  }
  {data.sections.cta && <CtaSection data={data.sections.cta} />}
</Layout>
