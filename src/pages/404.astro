---
import { withBase } from "@/lib/urls";
import Layout from "@/layouts/Layout.astro";
import Section from "@ui/Section.astro";
import Button from "@ui/Button.astro";

import siteConfig from "@/siteConfig";
---

<Layout
	title=`404 - Page Not Found | ${siteConfig.name}`
	description="404 page description place here"
>
	<Section
		class="section--centered section--full-height section--color-1"
		container="flex-column"
	>
		<h1>404 - Page Not Found</h1>
		<p class="subtitle">
			It looks like the page you are looking for has been moved or doesn't
			exist.
			<br />
			Let's get you back to your health journey.
		</p>

		<div class="actions">
			<Button href={withBase("/")} color="primary" variant="solid"
				>Back to Homepage</Button
			>
			<Button href={withBase("/appointment")} color="primary" variant="outline"
				>Book Appointment</Button
			>
		</div>
	</Section>
</Layout>
