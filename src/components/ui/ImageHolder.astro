---
export interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const classes = ["image-holder", className].filter(Boolean).join(" ");
---

<div class={classes}>
	<slot />
</div>

<style>
	.image-holder {
		height: 48rem;
		border-radius: 1.8rem;
		background-color: var(--color-text);
		box-shadow: 0 1.6rem 4rem 0 var(--color-shadow);
		overflow: hidden;

		img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		@media screen and (max-width: 1024px) {
			height: 38rem;
		}

		@media screen and (max-width: 768px) {
			height: 30rem;
		}

		@media screen and (max-width: 640px) {
			height: 25.6rem;
		}
	}
</style>
