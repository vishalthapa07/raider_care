---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";

interface Props {
	data: any;
}

const {
	data: { ...props },
} = Astro.props;
---

<Section
	class={props.config.class}
	background={props.config.background}
	sectionHeader={props.sectionHeader}
	headingLevel={1}
>
	<div class="pricing-header">
		{props.prices.title && <h2 set:html={props.prices.title} />}
		{props.prices.subtitle && <p set:html={props.prices.subtitle} />}
	</div>
	<ul class="pricing-list">
		{
			props.prices.list.map((item: any) => (
				<li class="pricing__item card">
					<span class="card-icon">
						<Icon name={item.icon} />
					</span>
					<div class="title">{item.title}</div>
					<p>{item.text}</p>
					<span class="price">
						Sarting from
						<span>{item.price}</span>
					</span>
				</li>
			))
		}
	</ul>

	{props.prices.rem && <span class="rem">{props.prices.rem}</span>}
</Section>

<style>
	.pricing-header {
		display: flex;
		margin-bottom: var(--global-gap);
		flex-direction: column;
		gap: 1.6rem;
	}

	.pricing-list {
		display: grid;
		margin-top: var(--global-gap);
		grid-template-columns: repeat(4, 1fr);
		gap: var(--global-gap);

		@media screen and (max-width: 1024px) {
			grid-template-columns: 1fr 1fr;
		}

		@media screen and (max-width: 640px) {
			grid-template-columns: 1fr;
		}
	}

	.pricing__item {
		display: flex;
		flex-direction: column;
		gap: 1.6rem;

		.title {
			color: var(--color-title);
			font-weight: 2rem;
			font-weight: 600;
		}

		.price {
			margin-top: auto;
			padding-top: 0.8rem;
			font-weight: 600;
			font-size: 1.4rem;
			line-height: 2;
			text-transform: uppercase;
			border-top: 1px solid var(--color-border);

			span {
				display: block;
				color: var(--color-primary);
				font-size: 1.8rem;
			}
		}
	}

	.rem {
		display: block;
		margin-top: var(--global-gap);
		font-size: 1.4rem;
		font-weight: 600;
		font-style: italic;
		color: var(--color-primary);
	}
</style>
