<div
  id="chat-box"
  class="chat-box"
  role="dialog"
  aria-labelledby="chat-title"
  hidden
>
  <header class="chat-header">
    <div class="chat-brand">
      <div class="chat-logo" aria-hidden="true">✚</div>

      <div>
        <strong id="chat-title">RaiderCare</strong>

        <span class="chat-status">
          <span class="online-dot"></span>
          Online health assistant
        </span>
      </div>
    </div>

    <button
      id="close-chat"
      class="close-chat"
      type="button"
      aria-label="Close chat"
    >
      ×
    </button>
  </header>

  <div id="chat-messages" class="chat-messages" aria-live="polite">
    <div class="message-row assistant-row">
      <div class="chat-avatar" aria-hidden="true">✚</div>

      <div class="message assistant">
        Hi! I’m RaiderCare. How can I help you today?
      </div>
    </div>

    <div class="quick-options">
      <button
        type="button"
        class="quick-option"
        data-message="I am not feeling well"
      >
        I’m not feeling well
      </button>

      <button
        type="button"
        class="quick-option"
        data-message="I need help finding a healthcare provider"
      >
        Find healthcare
      </button>

      <button
        type="button"
        class="quick-option"
        data-message="I feel stressed and anxious"
      >
        Mental health
      </button>
    </div>
  </div>

  <form id="chat-form" class="chat-form">
    <label class="sr-only" for="chat-input"> Type your message </label>

    <div class="chat-input-container">
      <input
        id="chat-input"
        type="text"
        placeholder="Type your message..."
        autocomplete="off"
        maxlength="300"
        required
      />

      <button
        id="send-chat"
        class="send-chat"
        type="submit"
        aria-label="Send message"
      >
        <span id="send-text">Send</span>

        <svg
          class="send-icon"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M22 2L11 13"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>

          <path
            d="M22 2L15 22L11 13L2 9L22 2Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </form>

  <p class="chat-disclaimer">
    For emergencies, call <a href="tel:911">911</a>. For a mental-health crisis,
    call or text <a href="tel:988">988</a>.
  </p>
</div>

<script>
  import { GoogleGenAI } from "@google/genai";

  const API_KEY = import.meta.env.PUBLIC_GEMINI_API_KEY;

  const MODEL = import.meta.env.PUBLIC_GEMINI_MODEL || "gemini-3.8-flash";

  const SYSTEM_INSTRUCTION = `You are RaiderCare, a friendly university health-navigation assistant.

Have a simple and supportive conversation with students.

Rules:
- Keep every response under 60 words.
- Do not diagnose diseases.
- Do not prescribe medication.
- Ask only one short follow-up question when necessary.
- For more detailed symptom guidance, tell the student to click "Find Your Health Expert".
- Do not display addresses, provider details, long medical explanations, or JSON data.
- For emergency symptoms, immediately tell the student to call 911.
- For suicidal thoughts or self-harm, tell the student to call or text 988. If danger is immediate, also call 911.
- Use plain text without Markdown symbols.`;

  const ai = API_KEY
    ? new GoogleGenAI({
        apiKey: API_KEY,
      })
    : null;

  const history: {
    role: "user" | "model";
    parts: { text: string }[];
  }[] = [];

  let requestInProgress = false;

  function getElements() {
    return {
      chatBox: document.querySelector<HTMLElement>("#chat-box"),
      messages: document.querySelector<HTMLElement>("#chat-messages"),
      input: document.querySelector<HTMLInputElement>("#chat-input"),
      sendButton: document.querySelector<HTMLButtonElement>("#send-chat"),
      sendText: document.querySelector<HTMLElement>("#send-text"),
    };
  }

  function openChat() {
    const { chatBox, input } = getElements();

    if (!chatBox) return;

    chatBox.hidden = false;

    requestAnimationFrame(() => {
      chatBox.classList.add("chat-box--open");
    });

    window.setTimeout(() => {
      input?.focus();
    }, 100);
  }

  function closeChat() {
    const { chatBox } = getElements();

    if (!chatBox) return;

    chatBox.classList.remove("chat-box--open");

    window.setTimeout(() => {
      chatBox.hidden = true;
    }, 180);
  }

  function addMessage(
    text: string,
    type: "user" | "assistant",
    showCareFinder = false,
  ) {
    const { messages } = getElements();

    if (!messages) return;

    const row = document.createElement("div");

    row.className =
      type === "assistant"
        ? "message-row assistant-row"
        : "message-row user-row";

    if (type === "assistant") {
      const avatar = document.createElement("div");

      avatar.className = "chat-avatar";
      avatar.textContent = "✚";
      avatar.setAttribute("aria-hidden", "true");

      row.appendChild(avatar);
    }

    const content = document.createElement("div");
    content.className = "message-content";

    const message = document.createElement("div");

    message.className = `message ${type}`;
    message.textContent = text.trim();

    content.appendChild(message);

    if (type === "assistant" && showCareFinder) {
      const careFinderLink = document.createElement("a");

      careFinderLink.className = "care-finder-link";
      careFinderLink.href = "/care-finder";
      careFinderLink.textContent = "Find Your Health Expert →";

      content.appendChild(careFinderLink);
    }

    row.appendChild(content);
    messages.appendChild(row);

    messages.scrollTo({
      top: messages.scrollHeight,
      behavior: "smooth",
    });
  }

  function showTyping() {
    const { messages } = getElements();

    if (!messages) return null;

    const row = document.createElement("div");

    row.className = "message-row assistant-row";

    const avatar = document.createElement("div");

    avatar.className = "chat-avatar";
    avatar.textContent = "✚";

    const typing = document.createElement("div");

    typing.className = "message assistant typing";
    typing.innerHTML = `
      <span></span>
      <span></span>
      <span></span>
    `;

    row.appendChild(avatar);
    row.appendChild(typing);
    messages.appendChild(row);

    messages.scrollTop = messages.scrollHeight;

    return row;
  }

  function getDummyResponse(userMessage: string) {
    const message = userMessage.toLowerCase();

    const emergencyWords = [
      "chest pain",
      "cannot breathe",
      "can't breathe",
      "difficulty breathing",
      "severe bleeding",
      "unconscious",
      "seizure",
      "overdose",
      "stroke",
    ];

    const crisisWords = [
      "suicide",
      "suicidal",
      "kill myself",
      "hurt myself",
      "self harm",
      "self-harm",
    ];

    const mentalHealthWords = [
      "anxiety",
      "anxious",
      "stress",
      "stressed",
      "depressed",
      "depression",
      "overwhelmed",
      "panic",
      "mental health",
    ];

    const greetingWords = [
      "hello",
      "hi",
      "hey",
      "good morning",
      "good afternoon",
    ];

    if (crisisWords.some((word) => message.includes(word))) {
      return {
        text: "I’m sorry you’re going through this. Please call or text 988 now for immediate support. If you are in immediate danger, call 911 or stay with someone you trust.",
        showCareFinder: false,
      };
    }

    if (emergencyWords.some((word) => message.includes(word))) {
      return {
        text: "These symptoms may be an emergency. Please call 911 immediately. Do not wait for an online response or drive yourself if your symptoms are severe.",
        showCareFinder: false,
      };
    }

    if (mentalHealthWords.some((word) => message.includes(word))) {
      return {
        text: "I’m sorry you’re feeling this way. RaiderCare can help you find university counseling and mental-health resources. You can also tell me a little more about how long you have felt this way.",
        showCareFinder: true,
      };
    }

    if (greetingWords.some((word) => message.includes(word))) {
      return {
        text: "Hi! I can provide basic health-navigation support. Tell me what you are experiencing, or use our Care Finder for more detailed guidance.",
        showCareFinder: true,
      };
    }

    return {
      text: "Thank you for sharing that. I can provide basic navigation, but I cannot diagnose your condition. Use RaiderCare’s Care Finder for more detailed guidance and an appropriate healthcare recommendation.",
      showCareFinder: true,
    };
  }

  async function sendMessage(userMessage: string) {
    const { input, sendButton, sendText } = getElements();

    if (!input || !sendButton || !sendText || requestInProgress) {
      return;
    }

    addMessage(userMessage, "user");

    input.value = "";
    requestInProgress = true;
    sendButton.disabled = true;
    sendText.textContent = "...";

    const typingIndicator = showTyping();

    try {
      if (!ai) {
        throw new Error("Gemini API key is unavailable.");
      }

      const requestHistory = [
        ...history.slice(-8),
        {
          role: "user" as const,
          parts: [{ text: userMessage }],
        },
      ];

      const response = await ai.models.generateContent({
        model: MODEL,
        contents: requestHistory,

        config: {
          systemInstruction: SYSTEM_INSTRUCTION,
          temperature: 0.3,
          maxOutputTokens: 120,
          thinkingConfig: {
            thinkingLevel: "LOW",
          },
        },
      });

      const reply = response.text?.trim();

      if (!reply) {
        throw new Error("Gemini returned no response.");
      }

      history.push({
        role: "user",
        parts: [{ text: userMessage }],
      });

      history.push({
        role: "model",
        parts: [{ text: reply }],
      });

      typingIndicator?.remove();

      addMessage(reply, "assistant", true);
    } catch (error) {
      console.error("RaiderCare chat error:", error);

      typingIndicator?.remove();

      const dummyResponse = getDummyResponse(userMessage);

      addMessage(dummyResponse.text, "assistant", dummyResponse.showCareFinder);
    } finally {
      requestInProgress = false;
      sendButton.disabled = false;
      sendText.textContent = "Send";

      input.focus();
    }
  }

  /*
   * The opening button is located in another component.
   */
  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    if (target.closest("#chat-with-us-button")) {
      event.preventDefault();
      openChat();
      return;
    }

    if (target.closest("#close-chat")) {
      event.preventDefault();
      closeChat();
      return;
    }

    const quickOption = target.closest<HTMLButtonElement>(".quick-option");

    if (quickOption) {
      const message = quickOption.dataset.message;

      if (message) {
        sendMessage(message);
      }
    }
  });

  document.addEventListener("submit", (event) => {
    const form = event.target;

    if (!(form instanceof HTMLFormElement)) return;
    if (form.id !== "chat-form") return;

    event.preventDefault();

    const { input } = getElements();

    const userMessage = input?.value.trim();

    if (userMessage) {
      sendMessage(userMessage);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    const { chatBox } = getElements();

    if (chatBox && !chatBox.hidden) {
      closeChat();
    }
  });
</script>

<style is:global>
  .chat-box {
