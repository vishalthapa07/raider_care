---
import { Icon } from "astro-icon/components";
import { images } from "@lib/images";
import Section from "@ui/Section.astro";

interface Props {
	data: any;
}

const {
	data: { ...props },
} = Astro.props;
---

<Section
	class={props.config.class}
	background={props.config.background}
	sectionHeader={props.sectionHeader}
>
	<div class="reasons">
		{
			props.reasons.map((item: any) => {
				const bgImage = item.image ? images[`../assets/${item.image}`] : null;
				return (
					<div
						class="card reason-card"
						style={
							bgImage ? `background-image: url('${bgImage.src}')` : undefined
						}
					>
						<span class="card-icon">
							<Icon name={item.icon} />
						</span>
						<div class="reason-card__inner">
							<h4>{item.title}</h4>
							<p>{item.text}</p>
						</div>
					</div>
				);
			})
		}
	</div>
</Section>

<style>
	.reasons {
		display: grid;
		margin-top: 6.4rem;
		grid-template-columns: repeat(12, 1fr);
		gap: 2.4rem;
		text-align: left;

		@media screen and (max-width: 1024px) {
			grid-template-columns: 1fr 1fr;
		}

		@media screen and (max-width: 768px) {
			grid-template-columns: 1fr;
		}
	}

	.reason-card {
		display: flex;
		flex-direction: column;
		gap: var(--content-gap);

		&:nth-child(4n + 1) {
			grid-column: 1 / 8;

			@media screen and (max-width: 1024px) {
				grid-column: span 1;
			}
		}

		&:nth-child(4n + 2) {
			grid-column: 8 / -1;

			@media screen and (max-width: 1024px) {
				grid-column: span 1;
			}
		}

		&:nth-child(4n + 3),
		&:nth-child(4n) {
			flex-direction: row;
			grid-column: span 6;

			@media screen and (max-width: 1024px) {
				flex-direction: column;
				grid-column: span 1;
			}
		}

		p {
			font-size: clamp(1.6rem, calc(1.527rem + 0.227vw), 1.8rem);
			line-height: 1.77;
		}

		&[style] {
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			position: relative;
			color: var(--color-white);

			&::before {
				content: "";
				position: absolute;
				inset: 0;
				background-color: var(--color-primary);
				opacity: 0.85;
				border-radius: inherit;
				z-index: 0;
			}

			> * {
				position: relative;
				z-index: 1;
			}

			h4,
			p {
				color: var(--color-white);
			}

			.card-icon {
				position: relative;
				color: var(--color-white);

				&::before {
					content: "";
					position: absolute;
					inset: 0;
					background-color: var(--color-primary);
					opacity: 0.8;
					border-radius: inherit;
					z-index: -1;
				}
			}
		}
	}

	.reason-card__inner {
		--content-gap: 1rem;

		display: flex;
		flex-direction: column;
		gap: var(--content-gap);
	}
</style>
