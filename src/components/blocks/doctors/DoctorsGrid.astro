---
import { withBase } from "@/lib/urls";
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import Button from "@ui/Button.astro";

export interface Doctor {
	name: string;
	specialty: string;
	rating: number;
	image: string;
	profileUrl: string;
	appointmentUrl: string;
}

interface Props {
	data: any;
}

const {
	data: { ...props },
} = Astro.props;
---

<Section
	class={props.config.class}
	background={props.config.background}
	sectionHeader={props.sectionHeader}
>
	{props.title && <h2>{props.title}</h2>}
	{props.subtitle && <p class="subtitle">{props.subtitle}</p>}

	<div class="doctors-grid">
		{
			props.doctorsList.map((doctor: Doctor) => (
				<article class="doctor-card" data-doctor-card>
					<div class="doctor-card__image">
						<img
							src={doctor.image}
							alt={`${doctor.name}, ${doctor.specialty}`}
							loading="lazy"
						/>
					</div>

					<div class="doctor-card__content">
						<div class="doctor-card__header">
							<h3>{doctor.name}</h3>
							<div class="doctor-card__rating">
								<Icon name="star" />
								<span>{doctor.rating}</span>
							</div>
						</div>

						<p class="doctor-card__specialty">{doctor.specialty}</p>

						<div class="doctor-card__actions">
							<Button
								href={withBase(doctor.appointmentUrl)}
								variant="solid"
								color="primary"
								class="doctor-card__btn"
							>
								Book Appointment
							</Button>
							<Button
								href={withBase(doctor.profileUrl)}
								variant="outline"
								color="primary"
								class="doctor-card__btn"
							>
								View Profile
							</Button>
						</div>
					</div>
				</article>
			))
		}
	</div>

	<div class="load-more-wrapper">
		<Button
			type="button"
			variant="outline"
			color="primary"
			class="load-more-btn"
		>
			Load more specialists
		</Button>
	</div>
</Section>

<style>
	.doctors-grid {
		display: grid;
		margin-top: 6rem;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--global-gap);
		margin-bottom: 4.8rem;

		@media screen and (max-width: 1023px) {
			grid-template-columns: repeat(2, 1fr);
		}

		@media screen and (max-width: 639px) {
			grid-template-columns: 1fr;
		}
	}

	.doctor-card {
		display: flex;
		height: 100%;
		padding: 3.2rem;
		gap: var(--content-gap);
		flex-direction: column;
		text-align: left;
		background-color: var(--color-white);
		border-radius: 2rem;
		box-shadow: 0 0.2rem 0.8rem var(--color-shadow);
		overflow: hidden;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.doctor-card__image {
		width: 100%;
		height: 38rem;
		border-radius: 1.8rem;
		overflow: hidden;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
	}

	.doctor-card__content {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
		flex-grow: 1;
	}

	.doctor-card__header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}

	.doctor-card__name {
		margin: 0;
		font-size: 1.6rem;
		line-height: 1.33;
		color: var(--color-title);
		flex-grow: 1;
	}

	.doctor-card__rating {
		display: flex;
		margin-top: 1rem;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		color: var(--color-primary);
		font-weight: 600;
		font-size: 1.4rem;

		:global(svg) {
			width: 1.6rem;
			height: 1.6rem;
			display: block;
		}
	}

	.doctor-card__specialty {
		margin: 0;
		font-size: 1.8rem;
		color: var(--color-primary);
		font-weight: 600;
		line-height: 1.43;
	}

	.doctor-card__actions {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
		margin-top: auto;
	}

	.doctor-card__btn {
		width: 100%;
	}

	.load-more-wrapper {
		display: flex;
		justify-content: center;
	}

	.load-more-btn {
		gap: 2rem;
	}

	.doctor-card.is-hidden {
		display: none;
	}
</style>

<script>
	const grid = document.querySelector(".doctors-grid");
	const cards = grid ? Array.from(grid.querySelectorAll(".doctor-card")) : [];
	const loadMore = document.querySelector(".load-more-btn");
	const INITIAL = 3;

	if (cards.length > INITIAL) {
		cards.slice(INITIAL).forEach((card) => card.classList.add("is-hidden"));

		if (loadMore) {
			loadMore.addEventListener("click", () => {
				cards.forEach((card) => card.classList.remove("is-hidden"));
				loadMore.style.display = "none";
			});
		}
	} else if (loadMore) {
		loadMore.style.display = "none";
	}
</script>
